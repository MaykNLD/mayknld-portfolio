# ============================================================
# MaykNLD Portfolio - Variables de entorno
# Copia este archivo como .env.local y rellena los valores
# NUNCA subas .env.local a Git (ya está en .gitignore)
# ============================================================

# Supabase (obtenlos en: supabase.com > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...TU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJ...TU_SERVICE_ROLE_KEY

# URL de la web (sin barra final)
# En local:      http://localhost:3000
# En producción: https://mayknld.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
